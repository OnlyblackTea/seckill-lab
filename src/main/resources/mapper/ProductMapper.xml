<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devteam.seckill.mapper.ProductMapper">

    <resultMap id="productMap" type="com.devteam.seckill.domain.Product">
        <id     property="id"         column="id"/>
        <result property="name"       column="name"/>
        <result property="categoryId" column="category_id"/>
        <result property="status"     column="status"/>
        <result property="price"      column="price"/>
        <result property="stock"      column="stock"/>
        <result property="version"    column="version"/>
        <result property="createdAt"  column="created_at"/>
    </resultMap>

    <sql id="baseColumns">
        id, name, category_id, status, price, stock, version, created_at
    </sql>

    <!-- Stage 0：主键查询（已实现） -->
    <select id="selectById" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE id = #{id}
    </select>

    <!-- Stage 0：全表查询（已实现）。大表下这是全表扫描，Stage 1 用它对比优化前后。 -->
    <select id="selectAll" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
    </select>

    <!-- ============================================================
         Stage 1：searchProducts —— 按「分类 + 上架状态 + 价格区间」搜索

         索引 idx_product_search (category_id, status, price) 的设计：
           * category_id / status 是等值谓词（=）→ 放最左，先把索引区间收窄；
           * price 既是范围谓词（BETWEEN）又是 ORDER BY 列 → 放最后。
             联合索引在等值前缀确定后，后续列天然有序，所以 price 范围扫描
             出来的顺序就是 price 升序，ORDER BY price ASC 直接复用索引顺序，
             既不回表排序、也不产生 Using filesort。
         ============================================================ -->
    <select id="searchProducts" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE category_id = #{categoryId}
          AND status      = #{status}
          AND price BETWEEN #{minPrice} AND #{maxPrice}
        ORDER BY price ASC
        LIMIT #{limit}
    </select>

</mapper>
