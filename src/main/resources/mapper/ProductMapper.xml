<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devteam.seckill.mapper.ProductMapper">

    <resultMap id="productMap" type="com.devteam.seckill.domain.Product">
        <id     property="id"         column="id"/>
        <result property="name"       column="name"/>
        <result property="categoryId" column="category_id"/>
        <result property="status"     column="status"/>
        <result property="price"      column="price"/>
        <result property="stock"      column="stock"/>
        <result property="version"    column="version"/>
        <result property="createdAt"  column="created_at"/>
    </resultMap>

    <sql id="baseColumns">
        id, name, category_id, status, price, stock, version, created_at
    </sql>

    <!-- Stage 0：主键查询 -->
    <select id="selectById" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE id = #{id}
    </select>

    <!-- 按主键查询（与 selectById 同义） -->
    <select id="findById" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE id = #{id}
    </select>

    <!-- Stage 0：全表查询（大表下全表扫描，Stage 1 用它对比优化前后） -->
    <select id="selectAll" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
    </select>

    <!-- 查询库存：Stage 2 验回滚、Stage 3 验不超卖、Stage 4 观察快照读 vs 当前读，都用它 -->
    <select id="selectStock" resultType="java.lang.Integer">
        SELECT stock FROM product WHERE id = #{id}
    </select>

    <!-- ============================================================
         Stage 1 参考解：searchProducts
         联合索引 idx_product_search (category_id, status, price) 的设计：
           * category_id / status 是等值谓词（=）→ 放最左，先把索引区间收窄；
           * price 既是范围谓词（BETWEEN）又是 ORDER BY 列 → 放最后。
             联合索引在等值前缀确定后，后续列天然有序，所以 price 范围扫描
             出来的顺序就是 price 升序，ORDER BY 直接复用索引顺序，无 filesort。
         ============================================================ -->
    <select id="searchProducts" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE category_id = #{categoryId}
          AND status      = #{status}
          AND price BETWEEN #{minPrice} AND #{maxPrice}
        ORDER BY price ASC
        LIMIT #{limit}
    </select>

    <!-- ============================================================
         Stage 2/3 参考解：decrementStock —— 原子扣减一件库存
         判断（stock > 0）与扣减（stock = stock - 1）在同一条 UPDATE 里：
         InnoDB 对该行加 X 锁，并在最新已提交版本上重新求值 WHERE（当前读），
         并发请求因此被行锁串行化 —— 这就是"不超卖"的根因。
         返回受影响行数：1 = 扣减成功，0 = 库存不足（售罄）。
         ============================================================ -->
    <update id="decrementStock">
        UPDATE product
        SET stock = stock - 1
        WHERE id = #{id}
          AND stock > 0
    </update>

    <!-- 骨架里遗留的"先读后写"式扣减：只把库存写成指定值，没有 stock > 0 守卫、也非原子。
         参考解不再调用它（保留绑定是为了让骨架/参考解共用同一套 Mapper 接口）。 -->
    <update id="updateStock">
        UPDATE product
        SET stock = #{stock}
        WHERE id = #{id}
    </update>

    <!-- 乐观锁路线（可选）：带 version 的 CAS 扣减；返回 0 表示版本被别人改过，需要重试 -->
    <update id="decrementStockOptimistic">
        UPDATE product
        SET stock = stock - 1, version = version + 1
        WHERE id = #{id}
          AND version = #{version}
          AND stock > 0
    </update>

</mapper>
