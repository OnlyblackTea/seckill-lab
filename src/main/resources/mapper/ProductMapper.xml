<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devteam.seckill.mapper.ProductMapper">

    <resultMap id="productMap" type="com.devteam.seckill.domain.Product">
        <id     property="id"         column="id"/>
        <result property="name"       column="name"/>
        <result property="categoryId" column="category_id"/>
        <result property="status"     column="status"/>
        <result property="price"      column="price"/>
        <result property="stock"      column="stock"/>
        <result property="version"    column="version"/>
        <result property="createdAt"  column="created_at"/>
    </resultMap>

    <sql id="baseColumns">
        id, name, category_id, status, price, stock, version, created_at
    </sql>

    <!-- Stage 0：主键查询（已实现） -->
    <select id="selectById" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
        WHERE id = #{id}
    </select>

    <!-- Stage 0：全表查询（已实现）。大表下这是全表扫描，Stage 1 用它对比优化前后。 -->
    <select id="selectAll" resultMap="productMap">
        SELECT <include refid="baseColumns"/>
        FROM product
    </select>

